__pycache__/
*.pyc
*.wav
.venv_poc/
.DS_Store
**/.DS_Store

# FSD50K dataset (49 GB — download from https://zenodo.org/records/4060432)
dataset/FSD50K/

# Generated audio splits — large binary data, not for version control
dataset/train/
dataset/val/
dataset/test/

# third_party contains nested git repos — key code is vendored in voiceiso/stages/
third_party/

# Regenerable embedding caches (re-created by scripts/retrain_head_dev.py)
checkpoints/dev_emb_cache.npz
checkpoints/fsd50k_emb_cache.npz

# Full EfficientAT AudioSet backbone exports — not needed at runtime
# (the backbone is embedded inside efficientat_head12.onnx already)
checkpoints/efficientat_s.onnx
checkpoints/efficientat_s.onnx.data
checkpoints/efficientat_s_4s.onnx
checkpoints/efficientat_s_4s.onnx.data

# Intermediate ONNX built during embedding extraction (regenerated by retrain_head_dev.py)
checkpoints/_embed_extractor.onnx
checkpoints/_embed_extractor.onnx.data
checkpoints/dev_emb_cache_v3.npz
checkpoints/dev_emb_cache_v4.npz

# Downloaded by scripts/fetch_dnsmos.py — not redistributed
checkpoints/sig_bak_ovr.onnx

# Scratch/working directories left behind by other local AI-assisted sessions
.codex-*/

# Office lock files (~$file.pptx etc.)
~$*

# Personal working notes — not part of the deliverable
Brief.rtf

# Presentation source material (slide decks, panel photos, drafts, PDFs) —
# kept locally for prep; the public repo ships only the written engineering
# reports already tracked directly under Docs/ (ARCHITECTURE.md,
# REVIEW_REPORT.md, REALWORLD_RESULTS.md).
Docs/Phase 1/
Docs/Phase 2/
Docs/Phase 3/
Docs/Panel Sign/
