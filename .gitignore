checkpoints/fsd50k_emb_cache.npz

# Full EfficientAT AudioSet backbone exports — not needed at runtime
# (the backbone is embedded inside efficientat_head12.onnx already)
checkpoints/efficientat_s.onnx
checkpoints/efficientat_s.onnx.data
checkpoints/efficientat_s_4s.onnx
checkpoints/efficientat_s_4s.onnx.data

# Intermediate ONNX built during embedding extraction (regenerated by retrain_head_dev.py)
checkpoints/_embed_extractor.onnx
checkpoints/_embed_extractor.onnx.data
checkpoints/dev_emb_cache_v3.npz
